generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model User {
  id              String        @id @default(uuid())
  username        String        @unique
  email           String        @unique
  password        String
  role            Role          @default(customer)
  createdAt       DateTime      @default(now())
  tokenVersion    Int           @default(0)
  shiftStatus     String        @default("offline")
  isEmailVerified Boolean       @default(false)
  disabledAt      DateTime?
  disabledReason  String?
  isActive        Boolean       @default(true)
  lastActiveAt    DateTime?
  lastLoginAt     DateTime?
  machines        Machine[]
  orders          Order[]
  receipts        Receipt[]
  transactions    Transaction[]
  favorites       Product[]     @relation("UserFavorites")
}

model Product {
  id             String                 @id @default(uuid())
  name           String
  price          Float
  tag            String                 @default("General")
  description    String?
  imageUrl       String                 @default("https://via.placeholder.com/200")
  views          Int                    @default(0)
  createdAt      DateTime               @default(now())
  tags           String[]               @default([])
  recipe         Json?
  count          Int                    @default(0)
  minThreshold   Int                    @default(5)
  reservedCount  Int                    @default(0)
  embedding      Unsupported("vector")?
  isAbTesting    Boolean                @default(false)
  variantAOrders Int                    @default(0)
  variantAPrice  Float?
  variantAViews  Int                    @default(0)
  variantBOrders Int                    @default(0)
  variantBPrice  Float?
  variantBViews  Int                    @default(0)
  variants       Json?
  favoritedBy    User[]                 @relation("UserFavorites")

  @@index([createdAt])
}

model Order {
  id                 String       @id @default(uuid())
  orderId            String       @unique
  client             String
  design             String
  items              Json
  status             String       @default("Pending Payment")
  progress           Int          @default(0)
  paymentStatus      String       @default("unpaid")
  paymentMethod      String       @default("none")
  address            String?
  deliveryTime       String?
  notes              String?
  totalAmount        Float        @default(0)
  date               DateTime     @default(now())
  userId             String
  transactionId      String?      @unique
  receiptId          String?      @unique
  estimatedTime      Int?
  isRush             Boolean      @default(false)
  priorityScore      Float        @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  calligraphyMessage String?
  giftPackaging      Boolean      @default(false)
  isByog             Boolean      @default(false)
  personalization    Json?
  waiverSigned       Boolean      @default(false)
  machineId          String?
  dueDate            DateTime?
  garmentsReceivedAt DateTime?
  garmentsReceivedBy String?
  stagingCubby       String?
  processedBy        String?
  receipt            Receipt?     @relation(fields: [receiptId], references: [id])
  transaction        Transaction? @relation(fields: [transactionId], references: [id])
  user               User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([machineId])
  @@index([status])
  @@index([createdAt])
  @@index([date])
}

model Inventory {
  id               String          @id @default(uuid())
  item             String          @unique
  count            Int             @default(0)
  unit             String          @default("Cones")
  lastUpdated      DateTime        @default(now()) @updatedAt
  minThreshold     Int             @default(10)
  reservedCount    Int             @default(0)
  supplierUnitCost Float?
  packSize         Int             @default(1)
  logs             InventoryLog[]
  purchaseOrders   PurchaseOrder[]
}

model InventoryLog {
  id          String    @id @default(uuid())
  inventoryId String
  action      String
  amount      Int
  newTotal    Int
  userId      String
  timestamp   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([timestamp])
}

model Transaction {
  id            String   @id @default(uuid())
  transactionID String   @unique
  orderID       String
  amount        Float
  status        String   @default("pending")
  receiptLink   String?
  receiptId     String?  @unique
  timestamp     DateTime @default(now())
  userId        String
  Order         Order?
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Receipt {
  id                   String   @id @default(uuid())
  receiptID            String   @unique
  orderID              String
  paymentMethod        String
  amount               Float
  status               String   @default("Pending")
  timestamp            DateTime @default(now())
  metadata             Json?
  userId               String
  aiVerificationStatus String   @default("pending")
  confidenceScore      Float    @default(0)
  ocrData              Json?
  imageUrl             String?
  flaggedReason        String?
  imageHash            String?  @unique
  referenceId          String?
  Order                Order?
  user                 User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderID])
  @@index([aiVerificationStatus])
}

model SiteTraffic {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  path      String   @default("/")
  userAgent String?
  isUnique  Boolean  @default(true)

  @@index([timestamp])
}

model SystemSettings {
  id                       String  @id @default("global")
  inventoryAuditLog        Boolean @default(true)
  giftPackagingPrice       Float   @default(5.00)
  aiChatModel              String  @default("llama-3.3-70b-versatile")
  aiProviderUrl            String  @default("https://api.groq.com/openai/v1/chat/completions")
  aiVisionModel            String  @default("llama-3.2-11b-vision-preview")
  minConfidenceScore       Float   @default(0.75)
  businessAddress          String  @default("123 Digital Thread Lane, Manila")
  businessContact          String  @default("0928 810 3928")
  businessEmail            String  @default("contact@stitch-opt.com")
  businessName             String  @default("STITCH-OPT DESIGNS")
  receiptTagline           String  @default("Premium Embroidery Services")
  businessWebsite          String  @default("www.stitch-opt.com")
  businessLogoUrl          String?
  gcashQrCodeUrl           String?
  deliveryEnabled          Boolean @default(false)
  autoReplyReviews         Boolean @default(true)
  artisanCapOffsetMinutes  Float   @default(0.5)
  artisanDailyMinutes      Float   @default(500.0)
  artisanHandlingMinutes   Float   @default(1.0)
  artisanSecondsPerLetter  Float   @default(12.0)
  efficiencyFactor         Float   @default(0.85)
  expressLanePercent       Float   @default(35.0)
  batchThrottlePeriod      String  @default("day")
  largeOrderQuoteThreshold Int       @default(100)
  maxBulkPiecesPerDay      Int       @default(50)
  emergencyNoticeActive    Boolean   @default(false)
  emergencyNoticeReason    String?
  emergencyNoticeMessage   String?
  emergencyNoticeDelayHours Int      @default(0)
  emergencyNoticeResumeDate DateTime?
  emergencyNoticeCreatedAt  DateTime?
  emergencyNoticeUpdatedBy  String?
  emergencyOrderingPolicy  String    @default("ALLOW_WITH_DELAY") // "ALLOW_WITH_DELAY" | "PAUSE_ORDERS"
}

model GlobalAuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  userId    String?
  userRole  String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  diff      Json?

  @@index([timestamp])
  @@index([userId])
}

model Machine {
  id             String   @id @default(uuid())
  name           String   @unique
  type           String   @default("Embroidery")
  status         String   @default("Idle")
  assignedUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id])

  @@index([assignedUserId])
  @@index([status])
}

model DeclinedRecommendation {
  id         String   @id @default(uuid())
  sugId      String   @unique
  declinedAt DateTime @default(now())
}

model PurchaseOrder {
  id            String    @id @default(uuid())
  inventoryId   String
  quantity      Int
  status        String    @default("Draft")
  estimatedCost Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Feedback {
  id               String    @id @default(uuid())
  category         String    @default("General")
  rating           Int       @default(5)
  message          String
  status           String    @default("Pending")
  staffNotes       String?
  customerName     String?
  customerEmail    String?
  orderId          String?
  userId           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  productId        String?
  merchantReply    String?
  merchantReplyAt  DateTime?
  isFeatured       Boolean   @default(false)
  rootCause        String?
  resolutionAction String?
  resolvedBy       String?

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([productId])
}

model MaintenanceTicket {
  id              String    @id @default(uuid())
  machineId       String
  machineName     String
  issueType       String    @default("Mechanical Jam")
  severity        String    @default("Warning")
  description     String
  status          String    @default("Open")
  reportedBy      String
  reportedById    String?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([machineId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

enum Role {
  admin
  employee
  customer
}

enum OrderStatus {
  Pending_Payment
  Processing
  Completed
  Cancelled
}
