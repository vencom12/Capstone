{
  "name": "stitchmaster-ai",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "framework": "npx -y concurrently \"npm run dev\" \"npm run dev --prefix frontend\"",
    "build": "npm install && npm install --include=dev --prefix frontend && npm run build --prefix frontend",
    "postinstall": "npx prisma generate && npm install --include=dev --prefix frontend && npm run build --prefix frontend",
    "postbuild": "echo Build Complete"
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  }
}
