# Server Port
PORT=5001
NODE_ENV=development
JWT_SECRET=stitchopt_super_secret_key_2024

# Database Transition (PostgreSQL / Supabase)
DB_TYPE=postgres
DATABASE_URL="postgresql://postgres:password@host:5432/postgres?connection_limit=3"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Features (Groq)
GROQ_API_KEY=

# Frontend Base URL
FRONTEND_URL=http://localhost:3000
BUSINESS_NAME="Stitch-Opt Designs"

# --- SMS Verification Gateway (Semaphore API - Philippines) ---
# If left blank, the system automatically runs in Capstone Defense Simulation Mode (prints code to terminal)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# --- Email Verification Gateway (Resend HTTP API — Recommended for Render/Cloud) ---
# Works over HTTPS Port 443 (Render blocks raw SMTP ports 25/465/587 on Free Tier)
RESEND_API_KEY=
RESEND_FROM="Stitch-Opt <onboarding@resend.dev>"

# --- Email Verification Gateway Fallback (Gmail SMTP / Nodemailer) ---
# Requires a 16-character Google App Password (not your normal Gmail login password)
# If left blank, the system automatically runs in Capstone Defense Simulation Mode (prints link to terminal)
GMAIL_USER=
GMAIL_APP_PASSWORD=
